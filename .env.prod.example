# =============================================================================
# Kuberan Production Environment
# =============================================================================
# Copy this file to .env.prod (chmod 600) and fill in all values.
# NEVER commit .env.prod to version control.
#
# docker-compose.prod.yml interpolates these values and hands each service ONLY
# the variables it needs (no shared env_file). A variable that is not
# referenced in docker-compose.prod.yml never reaches any container.
# Upgrade notes for existing installs: docs/backup-and-dr.md#upgrade-notes
# =============================================================================

# -- Cloudflare Tunnel / ingress ---------------------------------------------
# Public ingress is an external Cloudflare tunnel (cloudflared running on the
# host, managed outside this repo). Published ports bind to 127.0.0.1 only.
# Map ONLY these public hostnames in the dashboard (see docker-compose.prod.yml):
#   auth.<domain>/oauth2/register -> http://127.0.0.1:8080 (hardened DCR proxy, above the catch-all),
#   auth.<domain> -> http://127.0.0.1:4444, mcp.<domain> -> http://127.0.0.1:8081,
#   app.<domain> -> http://127.0.0.1:3000.
# Hydra admin (:4445) is never published.
#
# Address the published ports bind to. Keep 127.0.0.1 for a host-run tunnel.
# PUBLISH_ADDRESS=127.0.0.1
#
# First two octets of the fixed Docker subnets (edge = <prefix>.10.0/24,
# db .11, storage .12, hydra-admin .13). Change only if 172.30.x collides with
# an existing network, and update the *_CIDRS values below to match.
# KUBERAN_SUBNET_PREFIX=172.30
#
# Trusted proxy ranges. Tunnel traffic reaches the containers from the
# gateway of the kuberan "edge" network (172.30.10.1); these are narrowed to
# that network (was 172.16.0.0/12, every Docker bridge). For the tightest
# setting use 172.30.10.1/32.
#   API: whose X-Forwarded-For / client IP the api trusts (rate limits, audit).
API_TRUSTED_PROXY_CIDRS=172.30.10.0/24

# -- MCP OAuth (Ory Hydra) ---------------------------------------------------
# plan 015-mcp-oauth-hydra. Hydra is the OAuth 2.1 Authorization Server; the
# MCP server is a Resource Server validating Hydra-issued JWTs via JWKS.
#
# Dedicated Hydra database/schema on the same Postgres/Supabase instance.
# Self-hosted example: postgres://kuberan:<pw>@postgres:5432/hydra?sslmode=disable
# Supabase: create a dedicated schema + role in the main postgres database and
# target it via search_path, using the SESSION pooler (port 5432 - Hydra's
# long-lived connections break on the 6543 transaction pooler), e.g.:
#   postgres://hydra_svc.<project-ref>:<pw>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&search_path=hydra
HYDRA_DSN=
# Generate with: openssl rand -hex 32 (Hydra's system secret; rotating it
# invalidates all issued tokens - keep it stable).
HYDRA_SECRETS_SYSTEM=
# Public issuer served by cloudflared. Must be HTTPS and match the AS hostname.
HYDRA_ISSUER_URL=https://auth.kuberan.example.com
# Hydra admin API: fixed in docker-compose.prod.yml to http://hydra-admin:4445
# (internal network shared only by hydra and api). HYDRA_ADMIN_URL here is
# ignored.
# Login & consent pages (apps/web), served by cloudflared.
HYDRA_LOGIN_URL=https://app.kuberan.example.com/oauth/login
HYDRA_CONSENT_URL=https://app.kuberan.example.com/oauth/consent
# Public MCP Resource Server URL; tokens must carry this as their audience.
MCP_RESOURCE_URL=https://mcp.kuberan.example.com
# MCP write access (plan 022, docs/mcp-oauth.md). Off by default. Read by both
# the api (DCR + consent offer write:* scopes) and mcp (write tools). After
# turning it on, remove and re-add the Claude connector so it re-registers
# with the write scopes. Write scopes still need an explicit tick on the
# consent screen.
MCP_WRITE_ENABLED=false
# Per-change ceiling in cents (default $10,000) and per-app rate limits.
MCP_MAX_WRITE_AMOUNT=1000000
MCP_WRITE_RATE_PER_MINUTE=30
MCP_WRITE_RATE_PER_DAY=500
# Networks whose CF-Connecting-IP header the mcp server trusts for audit IPs
# (comma-separated CIDRs): the kuberan edge network the tunnel arrives from.
MCP_TRUSTED_PROXY_CIDRS=172.30.10.0/24
# Range Hydra trusts X-Forwarded-Proto from (the tunnel terminates TLS).
HYDRA_TLS_TERMINATION_CIDR=172.30.10.0/24
# Optional: override the default read:* scope set (write:* entries are
# ignored unless MCP_WRITE_ENABLED=true).
# OAUTH_SCOPES=
# Optional: pin a single pre-registered OAuth client id.
# HYDRA_PINNED_CLIENT_ID=

# -- API Configuration -------------------------------------------------------
# The api always listens on 8080 inside its container (fixed in compose).
ENV=production

# Generate with: openssl rand -hex 32 (must be at least 32 bytes in production)
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Generate with: openssl rand -hex 32
# Must match the oracle's PIPELINE_API_KEY
PIPELINE_API_KEY=

# Exact browser origin(s) of the web app, comma-separated. Required; "*" is
# rejected in production.
CORS_ORIGIN=https://app.kuberan.example.com
# Refresh-token cookie Secure flag; defaults to true outside development.
# Leave unset in production (the tunnel serves HTTPS).
# COOKIE_SECURE=true
# Abuse limits for public auth endpoints (0 disables a limit).
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_LOGIN_EMAIL_PER_HOUR=20
# RATE_LIMIT_REGISTER_PER_HOUR=5
# RATE_LIMIT_REFRESH_PER_MINUTE=60
# RATE_LIMIT_DCR_PER_HOUR=10
# Global JSON request body limit in bytes (attachment uploads have their own).
# MAX_BODY_BYTES=1048576

# Shared secret between the api and the Telegram bot (internal routes).
# Generate with: openssl rand -hex 32
BOT_INTERNAL_SECRET=

# -- Telegram bot ------------------------------------------------------------
# From @BotFather. Only the bot container receives it.
TELEGRAM_BOT_TOKEN=
# Log level for the bot (and the oracle); DEBUG logs telegram user ids.
# LOG_LEVEL=INFO

# -- Database ----------------------------------------------------------------
# Choose ONE of the options below and comment out the other.
# See docs/database-setup.md for full setup instructions.

# OPTION A: Self-hosted PostgreSQL (recommended for full self-hosting)
# Runs a local Postgres 16 container managed by Docker Compose.
# Set COMPOSE_PROFILES=postgres to activate the postgres service.
# Add 'backup' to enable automated daily backups (e.g., COMPOSE_PROFILES=postgres,backup).
# COMPOSE_PROFILES=postgres,backup
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=kuberan
# DB_PASSWORD=        # Generate: openssl rand -hex 32
# DB_NAME=kuberan
# DB_SSLMODE=disable

# OPTION B: Supabase (managed database)
# Connection pooling via Supavisor (transaction mode, port 6543).
# The deploy script automatically overrides to port 5432 (direct) for migrations,
# since golang-migrate requires advisory locks not supported by Supavisor.
# Find these in: Supabase Dashboard > Settings > Database
# Add 'backup' to enable automated daily backups (e.g., COMPOSE_PROFILES=backup).
COMPOSE_PROFILES=
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=6543
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require
# Connection pool (per process: api and mcp each open their own pool). Keep
# api + mcp MAX_OPEN below the pooler / Postgres connection limit.
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_IDLE_TIME=5m
# DB_CONN_MAX_LIFETIME=1h
# Oracle: timeout for the long-running snapshot / fixed-deposit pipeline calls
# (provider and price calls keep REQUEST_TIMEOUT, default 30s).
# PIPELINE_TIMEOUT=5m

# Optional connection-pool sizing for the api and mcp (code defaults apply
# when unset). Keep the sum across api+mcp under your server/pooler limit.
# DB_MAX_OPEN_CONNS=
# DB_MAX_IDLE_CONNS=

# -- Receipt attachments / MinIO (plans/017 Phase 4) -------------------------
# Self-hosted, S3-compatible object store for transaction receipts. MinIO runs
# as an INTERNAL-ONLY service (never published to the tunnel); the api reaches
# it over the private Docker network at http://minio:9000. STORAGE_ENDPOINT and
# STORAGE_USE_PATH_STYLE are hardcoded in docker-compose.prod.yml — only the
# credentials below need to be set here.
#
# Root credentials own the MinIO instance; minio-init uses them once to create
# the bucket and mint the scoped service account. Generate strong values:
#   openssl rand -hex 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Scoped service account the api authenticates with (least privilege, not root).
# minio-init provisions this account with these exact keys. MinIO caps service-
# account credentials: access key 3-20 chars, secret key 8-40 chars (longer
# values fail with "access key length should be between 3 and 20"). Generate:
#   openssl rand -hex 8     # STORAGE_ACCESS_KEY  -> 16 chars
#   openssl rand -hex 16    # STORAGE_SECRET_KEY  -> 32 chars
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Bucket name (also drives the backup service's RECEIPTS_BUCKET mirror). Default
# kuberan-receipts; override only if you need a different name.
# STORAGE_BUCKET=kuberan-receipts
# MinIO server image (also used by minio-init for `mc`). Defaults to a pinned
# build of the community fork, since upstream minio/minio is no longer on
# Docker Hub. Set e.g. MINIO_IMAGE=minio/minio:latest to keep a locally cached
# upstream image instead.
# MINIO_IMAGE=

# -- Off-host backup / DR (plans/017 Phase 0) --------------------------------
# The backup service (COMPOSE_PROFILES includes 'backup') pushes an encrypted
# copy of every pg_dump off-host to Cloudflare R2 via rclone. All values below
# are optional: leave RCLONE_CONFIG_R2CRYPT_REMOTE unset to keep on-disk-only
# backups. rclone remotes are defined purely by these RCLONE_CONFIG_* vars,
# so no rclone.conf file is needed. See docs/backup-and-dr.md.
#
# R2 target (create an R2 bucket "kuberan-backups" + an API token scoped to it):
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=            # R2 token access key id
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=        # R2 token secret
# RCLONE_CONFIG_R2_ENDPOINT=https://<acct>.r2.cloudflarestorage.com
#
# Client-side encryption wrapper — filenames + contents encrypted so Cloudflare
# cannot read them. Generate both with `rclone obscure <passphrase>` and ALSO
# store the plaintext passphrases in an off-VPS password manager; losing them
# makes the off-host copy permanently unrecoverable.
# RCLONE_CONFIG_R2CRYPT_TYPE=crypt
# RCLONE_CONFIG_R2CRYPT_REMOTE=r2:kuberan-backups
# RCLONE_CONFIG_R2CRYPT_PASSWORD=            # rclone obscure output
# RCLONE_CONFIG_R2CRYPT_PASSWORD2=           # rclone obscure output (salt)
#
# MinIO source for the receipts-bucket mirror (Phase 4). Once receipts are
# deployed, docker-compose.prod.yml sets RECEIPTS_BUCKET on the backup service,
# so backup.sh mirrors the bucket whenever R2 (r2crypt) is also configured.
# Set these to the SAME scoped keys as STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY
# above; leaving them unset while R2 is configured makes the mirror sync fail.
# RCLONE_CONFIG_MINIO_TYPE=s3
# RCLONE_CONFIG_MINIO_PROVIDER=Minio
# RCLONE_CONFIG_MINIO_ACCESS_KEY_ID=         # = STORAGE_ACCESS_KEY
# RCLONE_CONFIG_MINIO_SECRET_ACCESS_KEY=     # = STORAGE_SECRET_KEY
# RCLONE_CONFIG_MINIO_ENDPOINT=http://minio:9000
#
# Dead-man's-switch: backup.sh pings this only on full success, so a missed
# ping means the run failed. Create a check at e.g. healthchecks.io / hc-ping.com.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
#
# On-disk retention (days) and the Hydra database dumped alongside the app DB
# (skipped automatically when it does not exist, e.g. on Supabase).
# BACKUP_RETENTION_DAYS=30
# BACKUP_HYDRA_DB_NAME=hydra
# Fail the backup run (no healthcheck ping) when off-host replication is not
# configured, instead of only logging a loud warning. Recommended once R2 is set.
# BACKUP_REQUIRE_OFFHOST=true
#
# Weekly automated restore drill (apps/backup/restore-test.sh, Sundays 03:30
# UTC): restores the newest dump into a scratch database, runs sanity checks,
# drops it. Needs CREATEDB (self-hosted OPTION A has it).
# RESTORE_TEST_ENABLED=true
# RESTORE_TEST_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# -- Frontend ----------------------------------------------------------------
# Inlined at build time by Next.js. Must match your domain.
NEXT_PUBLIC_API_URL=https://kuberan.example.com
